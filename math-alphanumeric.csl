<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Liber ex Inane - Alphanumeric References</title>
    <id>urn:uuid:65e7b0ba-69cf-4536-b873-0d4ab620d57b</id>
    <category citation-format="label"/>
    <updated>2026-09-05T00:00:00+00:00</updated>
  </info>
  <macro name="label">
    <group>
      <text variable="citation-label"/>
      <text variable="year-suffix"/>
    </group>
  </macro>
  <macro name="authors">
    <names variable="author">
      <name and="text" delimiter=", "/>
      <substitute><names variable="editor"/></substitute>
    </names>
  </macro>
  <macro name="year">
    <date variable="issued"><date-part name="year"/></date>
  </macro>
  <macro name="publication">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <group delimiter=", ">
          <group delimiter=" ">
            <text variable="container-title" font-style="italic"/>
            <group>
              <text variable="volume"/>
              <text variable="issue" prefix="(" suffix=")"/>
            </group>
            <text macro="year" prefix="(" suffix=")"/>
          </group>
          <text variable="page"/>
        </group>
      </if>
      <else>
        <group delimiter=", ">
          <group delimiter=" ">
            <text variable="collection-title"/>
            <text variable="volume"/>
          </group>
          <text variable="publisher"/>
          <text macro="year"/>
        </group>
      </else>
    </choose>
  </macro>
  <citation disambiguate-add-year-suffix="true">
    <sort><key variable="author"/><key variable="issued"/><key variable="title"/></sort>
    <layout prefix="[" suffix="]" delimiter="; ">
      <group delimiter=", ">
        <text macro="label"/>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography hanging-indent="true" entry-spacing="1">
    <sort><key variable="author"/><key variable="issued"/><key variable="title"/></sort>
    <layout>
      <text macro="label" prefix="[" suffix="] "/>
      <group delimiter=". " suffix=".">
        <text macro="authors"/>
        <choose>
          <if type="book"><text variable="title" font-style="italic"/></if>
          <else><text variable="title"/></else>
        </choose>
        <text macro="publication"/>
        <text variable="DOI" prefix="doi: "/>
        <text variable="URL"/>
      </group>
    </layout>
  </bibliography>
</style>
